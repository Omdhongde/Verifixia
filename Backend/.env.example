# Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Model Configuration
MODEL_PATH=../models/xception_deepfake.pth

# Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8085,http://127.0.0.1:8085,http://localhost:8080,http://127.0.0.1:8080

# ── Firebase Admin SDK (backend) ─────────────────────────────────────────────
# Get this from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download the JSON file
#
# Option A: path to downloaded service-account JSON file
FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccount.json
#
# Option B: paste the entire JSON content as a single-line string
# (useful for cloud deployments like Netlify / Heroku)
FIREBASE_CREDENTIALS_JSON=
