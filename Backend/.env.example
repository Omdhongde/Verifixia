# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8085,https://your-site.netlify.app

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Set automatically by Netlify when Neon extension is connected
NETLIFY_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/database
DATABASE_URL=postgresql://user:password@localhost/verifixia

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
#
# Option A: path to the downloaded service-account JSON file (local dev)
FIREBASE_CREDENTIALS_PATH=
#
# Option B: full JSON content as a single-line string (cloud / Netlify)
FIREBASE_CREDENTIALS_JSON=
